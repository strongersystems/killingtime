# ---------------------------------------------------------------------------
# Killing Time progress tracker - configuration
# Copy this file to .env and fill in the values. Never commit .env.
# ---------------------------------------------------------------------------

# Warcraft Logs API client (https://www.warcraftlogs.com/api/clients/)
# Create a client named "KillingTime", redirect URL http://localhost:8000/callback,
# leave "Public Client" UNCHECKED, then paste the two values here.
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=

# Your guild, exactly as it appears on Warcraft Logs / Raider.IO
GUILD_NAME=Killing Time
GUILD_REALM=Draenor
GUILD_REGION=EU

# Guilds to compare against. Format: Name@realm/region, separated by semicolons.
# Realm-wide standings are always pulled from Raider.IO regardless of this list.
RIVAL_GUILDS=Internet Diff@draenor/eu; Advance@draenor/eu; Incentive@draenor/eu

# How many pages (100 guilds each) of the realm leaderboard to store per raid/difficulty.
RIO_REALM_SCAN_PAGES=2

# How many most-recent expansions to pull Warcraft Logs zones for (2 = current + previous).
SYNC_EXPANSIONS=2

# Optional: force a Warcraft Logs zone -> Raider.IO raid mapping when names don't match.
# JSON object of {"<wcl zone id>": "<raider.io raid slug>"}
# TIER_MAP={"46": "the-venomous-abyss"}

# Anthropic API key for the "Ask" feature (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
ASK_MODEL=claude-opus-5
# low | medium | high | xhigh | max
ASK_EFFORT=high
# Server-side refusal fallbacks (recommended, keeps answers flowing if a request is declined)
ASK_ENABLE_FALLBACKS=true

# Where the SQLite database lives
KT_DB_PATH=data/killingtime.db

# Web server
KT_HOST=127.0.0.1
KT_PORT=8000
